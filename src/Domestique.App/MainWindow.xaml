<Window x:Class="Domestique.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Domestique.App"
        Title="Domestique" Width="748" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" AllowDrop="True"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Drop="Window_Drop" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <!-- weicher Schein am unteren Rand einer Meldung (Sheet 10), Farbe je nach Meldung -->
        <RadialGradientBrush x:Key="GlowMask">
            <GradientStop Color="#C0000000" Offset="0"/>
            <GradientStop Color="#50000000" Offset="0.5"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </RadialGradientBrush>
    </Window.Resources>

    <!-- Außen je 14 px für die Notch-Ohren, damit sich die Breite beim Andocken nicht ändert.
         Unten 12 px durchsichtig: Platz zum Nachfedern beim Aufklappen. Durchsichtige Pixel lassen Klicks durch. -->
    <!-- Die Insel sitzt oben mittig; die Ohren hängen direkt an ihr, auch wenn sie minimiert schmal ist -->
    <Grid x:Name="Root" Margin="0,0,0,12">
      <Grid x:Name="IslandGrid" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="14"/>
        </Grid.ColumnDefinitions>
        <Path x:Name="LeftEar" Data="M0,0 L14,0 L14,14 A14,14 0 0 0 0,0 Z" VerticalAlignment="Top" Visibility="Collapsed"/>
        <Path x:Name="RightEar" Grid.Column="2" Data="M14,0 L0,0 L0,14 A14,14 0 0 1 14,0 Z" VerticalAlignment="Top" Visibility="Collapsed"/>

        <Border x:Name="Shell" Grid.Column="1" Width="720" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource ShellRadius}" Padding="10,8,10,10">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Load route …" Click="LoadRoute_Click"/>
                    <MenuItem Header="End ERG   Ctrl+Alt+End" Click="EndErg_Click"/>
                    <MenuItem Header="Export ride" Click="Export_Click"/>
                    <MenuItem Header="Settings   Ctrl+Alt+O" Click="SettingsMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Quit" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
            <StackPanel x:Name="Expanded">
                <!-- Kopfzeile wie im Notch-Vorbild: links Ansichten, rechts Werkzeuge -->
                <Grid x:Name="Header" Height="28">
                    <Grid x:Name="TabBar" HorizontalAlignment="Left">
                        <!-- Auswahl gleitet zum gewählten Tab und federt nach -->
                        <Border x:Name="TabPill" Width="34" Height="26" CornerRadius="13" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource ChipBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="HomeTab" Style="{StaticResource NavTab}" Content="&#xE80F;" ToolTip="Overview" IsChecked="True" Checked="Tab_Checked"/>
                            <RadioButton x:Name="RouteTab" Style="{StaticResource NavTab}" Content="&#xE707;" ToolTip="Route" Checked="Tab_Checked"/>
                            <RadioButton x:Name="ErgTab" Style="{StaticResource NavTab}" Content="&#xE945;" ToolTip="ERG" Checked="Tab_Checked"/>
                        </StackPanel>
                    </Grid>
                    <!-- kurze Hinweise statt Meldungen über dem Inhalt: Punkt in der Farbe der Art, Text, verschwindet von selbst -->
                    <StackPanel x:Name="NoticeBar" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                                Opacity="0" IsHitTestVisible="False">
                        <Ellipse x:Name="NoticeDot" Width="6" Height="6" Margin="0,1,7,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="NoticeText" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Zustand und Anzahl verbundener Bluetooth-Geräte, Klick öffnet die Bluetooth-Einstellungen -->
                        <Button x:Name="LinkButton" Style="{StaticResource LinkPill}" Click="LinkButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LinkDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="LinkCount" Text="0" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="ClickThroughButton" Style="{StaticResource NavButton}" Click="ClickThrough_Click"
                                      ToolTip="Click-through: clicks go to the video. Ctrl+Alt+D to undo">
                            <Path Data="M0,0 L0,12.5 L3.4,9.4 L5.8,14.6 L8,13.6 L5.6,8.5 L10.2,8.5 Z" Height="13" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <!-- minimieren: nur noch Watt, Puls und Trittfrequenz in der kleinen Notch -->
                        <Button x:Name="MinimizeButton" Style="{StaticResource NavButton}" Content="&#xE70E;" ToolTip="Minimize" Click="Minimize_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="&#xE713;" ToolTip="Settings (Ctrl+Alt+O)" Click="SettingsMenu_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Inaktive Ansichten sind nur verborgen (Hidden): Alle Tabs sind so hoch wie die Übersicht, der Tab-Wechsel
                     ändert die Fenstergröße nicht. Die Übersicht ist oben ausgerichtet, damit das Fenster auch wieder schrumpft.
                     Der Zuschnitt reicht 8 px in den Rand, damit Inhalte beim Erscheinen nachfedern können, ohne abgeschnitten zu werden. -->
                <Grid x:Name="Views" Margin="-8,0,-8,-8" ClipToBounds="True">
                <Grid x:Name="ViewsArea" Margin="8,8,8,8">

                    <!-- ===== Übersicht: links wie das Zwift-HUD Avatar, Watt, Puls und Trittfrequenz; rechts Strecke und weitere Werte ===== -->
                    <Grid x:Name="HomeView" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="364"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Links: Avatar mit Zone, große Wattzahl mit Blitz und W, daneben Puls und Kadenz mit kleinen Symbolen -->
                        <Border x:Name="RideCard" Style="{StaticResource Card}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar, darunter die Leistungszone nach FTP. Reagiert auf Maus und Antippen. -->
                                <StackPanel Width="96" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <!-- gleiche Größe wie beim Start (Körper 58 px), damit er nahtlos hierher gleitet -->
                                    <local:Avatar x:Name="Mascot" Width="96" Height="81" IsHitTestVisible="True"
                                                  MouseEnter="Mascot_MouseEnter" MouseLeave="Mascot_MouseLeave" MouseLeftButtonDown="Mascot_Poke"/>
                                    <UniformGrid x:Name="ZoneBar" Columns="6" Height="6" Margin="12,6,12,0">
                                        <Border CornerRadius="2" Margin="0,0,1.5,0"/>
                                        <Border CornerRadius="2" Margin="0,0,1.5,0"/>
                                        <Border CornerRadius="2" Margin="0,0,1.5,0"/>
                                        <Border CornerRadius="2" Margin="0,0,1.5,0"/>
                                        <Border CornerRadius="2" Margin="0,0,1.5,0"/>
                                        <Border CornerRadius="2"/>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- Watt groß; vierstellige Werte werden notfalls etwas kleiner statt überzulaufen -->
                                <StackPanel x:Name="PowerColumn" Grid.Column="1" VerticalAlignment="Center">
                                    <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Vintage: Farbstreifen laufen in die Zahl -->
                                            <StackPanel Visibility="{DynamicResource StripeVisibility}" Width="22" Margin="0,6,7,0" VerticalAlignment="Center">
                                                <Rectangle Height="3" Margin="0,0,0,1" Fill="{DynamicResource Stripe1Brush}"/>
                                                <Rectangle Height="3" Margin="0,0,0,1" Fill="{DynamicResource Stripe2Brush}"/>
                                                <Rectangle Height="3" Margin="0,0,0,1" Fill="{DynamicResource Stripe3Brush}"/>
                                                <Rectangle Height="3" Margin="0,0,0,1" Fill="{DynamicResource Stripe4Brush}"/>
                                            </StackPanel>
                                            <!-- Tour: gelber Balken wie in der TV-Grafik -->
                                            <Rectangle Visibility="{DynamicResource AccentBarVisibility}" Width="4" Margin="0,12,9,10"
                                                       RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}"/>
                                            <TextBlock Style="{DynamicResource BigNumber}" FontSize="{DynamicResource HeroNumberSize}" VerticalAlignment="Center">
                                                <Run x:Name="PowerRun" Text="–"/>
                                            </TextBlock>
                                            <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                                                <Path Data="M7,0 L15,0 L10,9 L16,9 L5,24 L8,13 L2,13 Z" Width="17" Height="25" Stretch="Uniform"
                                                      HorizontalAlignment="Center" Fill="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="W" Style="{DynamicResource BigNumber}" FontSize="{DynamicResource UnitSize}"
                                                           HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Viewbox>
                                    <Border x:Name="TargetChip" CornerRadius="6" Padding="6,1" HorizontalAlignment="Left"
                                            Background="{DynamicResource AccentBrush}" Visibility="Collapsed">
                                        <TextBlock x:Name="TargetChipText" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Puls und Kadenz: große Zahl, kleines Symbol oben rechts daneben -->
                                <StackPanel x:Name="SideColumn" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Background="Transparent" ToolTip="Heart rate (bpm)">
                                        <TextBlock Style="{DynamicResource BigNumber}" FontSize="{DynamicResource SideNumberSize}"><Run x:Name="HeartRun" Text="–"/></TextBlock>
                                        <Path x:Name="HeartIcon" Width="15" Height="13" Stretch="Uniform" Margin="3,6,0,0" VerticalAlignment="Top"
                                              Fill="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Background="Transparent" ToolTip="Cadence (rpm)">
                                        <TextBlock Style="{DynamicResource BigNumber}" FontSize="{DynamicResource SideNumberSize}"><Run x:Name="CadenceRun" Text="–"/></TextBlock>
                                        <Path x:Name="CadenceIcon" Width="15" Height="15" Stretch="Uniform" Margin="3,6,0,0" VerticalAlignment="Top"
                                              Fill="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Rechts: Strecke, wenn gewählt, darunter die Werte. Die Kacheln füllen genau die Höhe der linken Karte. -->
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="RouteLoaded" Visibility="Collapsed">
                                <DockPanel Margin="2,0,2,4">
                                    <TextBlock x:Name="GradeValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="RouteNameText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Grid x:Name="RouteGraphics" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- gefahrener Teil jeweils in der Akzentfarbe -->
                                    <Border Style="{StaticResource Card}" Padding="5">
                                        <Canvas Width="72" Height="72">
                                            <Polyline x:Name="MapLine" StrokeThickness="1.5" Stroke="{DynamicResource SubtleBrush}" StrokeLineJoin="Round" Opacity="0.7"/>
                                            <Polyline x:Name="MapDone" StrokeThickness="2.5" Stroke="{DynamicResource AccentBrush}" StrokeLineJoin="Round"/>
                                            <Ellipse x:Name="MapDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
                                        </Canvas>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8,5" Margin="8,0,0,0">
                                        <Canvas Width="216" Height="72">
                                            <Polygon x:Name="ProfileArea" Fill="{DynamicResource ChipBrush}" Opacity="0.6"/>
                                            <Polygon x:Name="ProfileDoneArea" Fill="{DynamicResource ProfileFillBrush}"/>
                                            <Polyline x:Name="ProfileLine" StrokeThickness="1.5" Stroke="{DynamicResource SubtleBrush}" StrokeLineJoin="Round" Opacity="0.7"/>
                                            <Polyline x:Name="ProfileDone" StrokeThickness="2" Stroke="{DynamicResource AccentBrush}" StrokeLineJoin="Round"/>
                                            <Ellipse x:Name="ProfileDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
                                        </Canvas>
                                    </Border>
                                </Grid>
                            </StackPanel>
                            <!-- ohne Strecke 2 × 2, mit Strecke in einer Reihe -->
                            <UniformGrid x:Name="StatsGrid" Grid.Row="1" Columns="2" Margin="-3">
                                <Border Style="{StaticResource Card}" Padding="7,7" Margin="3">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SPEED" Style="{StaticResource Caption}"/>
                                        <TextBlock Style="{StaticResource Value}" FontSize="15"><Run x:Name="SpeedRun" Text="–"/><Run Text=" km/h" FontSize="10.5"/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="7,7" Margin="3">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="DISTANCE" Style="{StaticResource Caption}"/>
                                        <TextBlock Style="{StaticResource Value}" FontSize="15"><Run x:Name="DistanceRun" Text="–"/><Run Text=" km" FontSize="10.5"/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="7,7" Margin="3">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CLIMB" Style="{StaticResource Caption}"/>
                                        <TextBlock Style="{StaticResource Value}" FontSize="15"><Run x:Name="ClimbRun" Text="–"/><Run Text=" m" FontSize="10.5"/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="7,7" Margin="3">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="TIME" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="TimeValue" Style="{StaticResource Value}" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Grid>

                    <!-- ===== Strecke wählen: Datei hinzufügen oder aus der Bibliothek, rechts oben bestätigen ===== -->
                    <Grid x:Name="RouteView" Visibility="Hidden">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel x:Name="RouteBar" Margin="0,0,0,6">
                            <Button x:Name="ConfirmRouteButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Use route"
                                    Padding="14,4" Margin="8,0,0,0" Click="ConfirmRoute_Click"/>
                            <Border x:Name="SourceBar" DockPanel.Dock="Right" Style="{StaticResource SegmentBar}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="OwnRoutesSegment" Style="{StaticResource Segment}" GroupName="RouteSource" Content="Mine" IsChecked="True" Checked="RouteSource_Checked"/>
                                    <RadioButton x:Name="AppRoutesSegment" Style="{StaticResource Segment}" GroupName="RouteSource" Content="Built-in" Checked="RouteSource_Checked"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="AddSegment" Style="{StaticResource Segment}" GroupName="RouteMode" Content="Add" Checked="RouteMode_Checked"/>
                                    <RadioButton x:Name="LibrarySegment" Style="{StaticResource Segment}" GroupName="RouteMode" Content="Library" IsChecked="True" Checked="RouteMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- Hinzufügen: Datei aufs Overlay ziehen oder auswählen -->
                        <Grid x:Name="AddPanel" Grid.Row="1" Visibility="Collapsed">
                            <Rectangle RadiusX="12" RadiusY="12" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"
                                       Fill="{DynamicResource CardBrush}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="24" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleBrush}" Margin="0,0,14,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Drop a GPX file here" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="It goes to your library." Style="{StaticResource CardText}"/>
                                </StackPanel>
                                <Button Content="Choose file" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Margin="18,0,0,0" Click="PickRouteFile_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bibliothek: eigene oder mitgelieferte Strecken in zwei Spalten, ganz vorn „Keine Strecke“ -->
                        <ListBox x:Name="RouteList" Grid.Row="1" Style="{StaticResource CompactList}" MouseDoubleClick="ConfirmRoute_Click">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" Margin="0,1,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- ===== ERG: kompakt in der Breite ===== -->
                    <Border x:Name="ErgView" Style="{StaticResource Card}" Visibility="Hidden">
                        <StackPanel VerticalAlignment="Center">
                            <DockPanel>
                                <Border x:Name="ModeChip" DockPanel.Dock="Right" CornerRadius="6" Padding="7,1" Background="{DynamicResource ChipBrush}">
                                    <TextBlock x:Name="ModeText" FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="TARGET POWER" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="230"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource RoundButton}" Content="−" ToolTip="−10 W (Ctrl+Alt+PgDn)" Click="PowerDown_Click" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Style="{DynamicResource BigNumber}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Run x:Name="ErgRun" Text="–"/><Run Text=" W" FontSize="15"/>
                                </TextBlock>
                                <Button Grid.Column="2" Style="{StaticResource RoundButton}" Content="+" ToolTip="+10 W (Ctrl+Alt+PgUp)" Click="PowerUp_Click" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Button x:Name="ErgToggleButton" Style="{StaticResource AccentButton}" Content="Start ERG" Click="ErgToggle_Click"/>
                                    <TextBlock x:Name="ErgHint" Style="{StaticResource CardText}" FontSize="10.5" HorizontalAlignment="Center"
                                               TextAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== Bluetooth aus: bleibt stehen, bis man tippt (Windows-Einstellungen) oder Bluetooth einschaltet ===== -->
                    <Border x:Name="BluetoothCard" Visibility="Collapsed" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource ToastBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" MouseLeftButtonDown="BluetoothCard_Click" Cursor="Hand">
                        <Grid ClipToBounds="True">
                            <Ellipse x:Name="BluetoothGlow" Width="360" Height="110" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-62"
                                     Opacity="0" IsHitTestVisible="False" OpacityMask="{StaticResource GlowMask}" Fill="{DynamicResource NegativeBrush}"/>
                            <DockPanel Margin="12,12,16,12" VerticalAlignment="Center">
                                <local:Avatar x:Name="BluetoothAvatar" Width="96" Height="81" Margin="0,0,12,0"/>
                                <StackPanel x:Name="BluetoothText" VerticalAlignment="Center">
                                    <TextBlock Text="Bluetooth is off" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Tap to turn it on. I'll connect by myself."
                                               Style="{StaticResource CardText}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>


                </Grid>
                </Grid>
            </StackPanel>

            <!-- ===== Minimiert (Sheet 3, obere Reihe): kleine Notch mit Avatar und den drei Werten. Nur per Knopf. ===== -->
            <DockPanel x:Name="CompactBar" Height="36" Visibility="Collapsed" ClipToBounds="True">
                <local:Avatar x:Name="MiniMascot" Width="38" Height="31" Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="True"
                              MouseEnter="Mascot_MouseEnter" MouseLeave="Mascot_MouseLeave" MouseLeftButtonDown="Mascot_Poke"/>
                <Button x:Name="ExpandButton" DockPanel.Dock="Right" Style="{StaticResource NavButton}" Content="&#xE70D;" ToolTip="Expand"
                        VerticalAlignment="Center" Click="Expand_Click"/>
                <StackPanel x:Name="CompactValues" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource BigNumber}" FontSize="21" VerticalAlignment="Center"><Run x:Name="MiniPowerRun" Text="–"/></TextBlock>
                    <Path Data="M7,0 L15,0 L10,9 L16,9 L5,24 L8,13 L2,13 Z" Width="9" Height="13" Stretch="Uniform" Margin="4,0,14,0" VerticalAlignment="Center"
                          Fill="{DynamicResource TextBrush}"/>
                    <TextBlock Style="{DynamicResource BigNumber}" FontSize="17" VerticalAlignment="Center"><Run x:Name="MiniHeartRun" Text="–"/></TextBlock>
                    <Path x:Name="MiniHeartIcon" Width="11" Height="10" Stretch="Uniform" Margin="3,0,14,6" VerticalAlignment="Center"
                          Fill="{DynamicResource TextBrush}"/>
                    <TextBlock Style="{DynamicResource BigNumber}" FontSize="17" VerticalAlignment="Center"><Run x:Name="MiniCadenceRun" Text="–"/></TextBlock>
                    <Path x:Name="MiniCadenceIcon" Width="11" Height="11" Stretch="Uniform" Margin="3,0,0,6" VerticalAlignment="Center"
                          Fill="{DynamicResource TextBrush}"/>
                </StackPanel>
            </DockPanel>

            <!-- Start wie in Sheet 1 und 2: zeichnet Karte, Partikel und den Avatar, solange der Start läuft -->
            <local:GreetingView x:Name="Greeting" Margin="-10,-8,-10,-10" Visibility="Collapsed"/>
            <!-- Strecke laden: der Avatar fährt kurz über das Höhenprofil der neuen Strecke -->
            <local:RideView x:Name="Ride" Margin="-10,-8,-10,-10" Visibility="Collapsed"/>
            </Grid>
        </Border>
      </Grid>
    </Grid>
</Window>