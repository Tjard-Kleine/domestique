<Window x:Class="Domestique.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Domestique.App"
        Title="Domestique" Width="368" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" AllowDrop="True"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Drop="Window_Drop" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Margin" Value="1,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <Style x:Key="RowDot" TargetType="Ellipse">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Height" Value="5"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
        </Style>
    </Window.Resources>

    <!-- Außen je 14 px für die Notch-Ohren, damit sich die Breite beim Andocken nicht ändert -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="14"/>
        </Grid.ColumnDefinitions>
        <Path x:Name="LeftEar" Data="M0,0 L14,0 L14,14 A14,14 0 0 0 0,0 Z" VerticalAlignment="Top" Visibility="Collapsed"/>
        <Path x:Name="RightEar" Grid.Column="2" Data="M14,0 L0,0 L0,14 A14,14 0 0 1 14,0 Z" VerticalAlignment="Top" Visibility="Collapsed"/>

        <Border x:Name="Shell" Grid.Column="1" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource ShellRadius}" Padding="10,8,10,10">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Strecke laden …" Click="LoadRoute_Click"/>
                    <MenuItem Header="ERG beenden   Strg+Alt+Ende" Click="EndErg_Click"/>
                    <MenuItem Header="Fahrt exportieren" Click="Export_Click"/>
                    <MenuItem Header="Einstellungen   Strg+Alt+O" Click="SettingsMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Beenden" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <StackPanel>
                <!-- Kopfzeile wie im Notch-Vorbild: links Ansichten, rechts Werkzeuge -->
                <Grid Height="28">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="HomeTab" Style="{StaticResource NavTab}" Content="&#xE80F;" ToolTip="Übersicht" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="RouteTab" Style="{StaticResource NavTab}" Content="&#xE707;" ToolTip="Strecke" Checked="Tab_Checked"/>
                        <RadioButton x:Name="ErgTab" Style="{StaticResource NavTab}" Content="&#xE945;" ToolTip="ERG-Steuerung" Checked="Tab_Checked"/>
                        <Button Style="{StaticResource NavButton}" Content="&#xE710;" ToolTip="Strecke laden (GPX)" Click="LoadRoute_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse x:Name="LinkDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}"/>
                        <ToggleButton x:Name="ClickThroughButton" Style="{StaticResource NavButton}" Click="ClickThrough_Click"
                                      ToolTip="Durchklicken: Mausklicks gehen ans Video. Zurück mit Strg+Alt+D">
                            <Path Data="M0,0 L0,12.5 L3.4,9.4 L5.8,14.6 L8,13.6 L5.6,8.5 L10.2,8.5 Z" Height="13" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <Button Style="{StaticResource NavButton}" Content="&#xE713;" ToolTip="Einstellungen (Strg+Alt+O)" Click="SettingsMenu_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Feste Höhe: Tab-Wechsel und Meldungen ändern die Fenstergröße nicht -->
                <Grid Height="170" Margin="0,8,0,0" ClipToBounds="True">

                    <!-- ===== Übersicht ===== -->
                    <Grid x:Name="HomeView">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="2,2,10,0">
                            <local:Avatar x:Name="Mascot" Width="56" Height="46" HorizontalAlignment="Left"/>
                            <TextBlock Text="Domestique" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,0"/>
                            <TextBlock x:Name="SubtitleText" Text="Suche Trainer …" FontSize="11" Foreground="{DynamicResource SubtleBrush}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Margin="0,8,0,0">
                                <DockPanel Margin="0,0,0,2"><Ellipse x:Name="TrainerDot" Style="{StaticResource StatusDot}"/><TextBlock Text="Trainer" FontSize="11.5"/></DockPanel>
                                <DockPanel Margin="0,0,0,2"><Ellipse x:Name="ControlDot" Style="{StaticResource StatusDot}"/><TextBlock Text="Steuerung" FontSize="11.5"/></DockPanel>
                                <DockPanel Margin="0,0,0,2"><Ellipse x:Name="HeartDot" Style="{StaticResource StatusDot}"/><TextBlock Text="Puls" FontSize="11.5"/></DockPanel>
                                <DockPanel><Ellipse x:Name="RecordDot" Style="{StaticResource StatusDot}"/><TextBlock Text="Aufnahme" FontSize="11.5"/></DockPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,9,12,8">
                            <StackPanel>
                                <DockPanel>
                                    <Border x:Name="ZoneChip" DockPanel.Dock="Right" CornerRadius="6" Padding="6,1" Visibility="Collapsed">
                                        <TextBlock x:Name="ZoneText" FontSize="10.5" FontWeight="Bold" Foreground="#141414"/>
                                    </Border>
                                    <Border x:Name="TargetChip" DockPanel.Dock="Right" CornerRadius="6" Padding="6,1" Margin="0,0,4,0"
                                            Background="{DynamicResource AccentBrush}" Visibility="Collapsed">
                                        <TextBlock x:Name="TargetChipText" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="LEISTUNG · 3 s" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Vintage: Farbstreifen laufen vom Kartenrand in die Zahl -->
                                    <StackPanel Visibility="{DynamicResource StripeVisibility}" Width="58" Margin="-13,6,10,0" VerticalAlignment="Center">
                                        <Rectangle Height="3" Margin="0,0,0,1" Fill="{DynamicResource Stripe1Brush}"/>
                                        <Rectangle Height="3" Margin="0,0,0,1" Fill="{DynamicResource Stripe2Brush}"/>
                                        <Rectangle Height="3" Margin="0,0,0,1" Fill="{DynamicResource Stripe3Brush}"/>
                                        <Rectangle Height="3" Margin="0,0,0,1" Fill="{DynamicResource Stripe4Brush}"/>
                                    </StackPanel>
                                    <!-- Tour: gelber Balken wie in der TV-Grafik -->
                                    <Rectangle Visibility="{DynamicResource AccentBarVisibility}" Width="4" Margin="0,9,11,7"
                                               RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}"/>
                                    <TextBlock Grid.Column="1" Style="{DynamicResource BigNumber}" VerticalAlignment="Center">
                                        <Run x:Name="PowerRun" Text="–"/><Run Text=" W" FontSize="15"/>
                                    </TextBlock>
                                </Grid>
                                <DockPanel x:Name="CadenceRow" Margin="0,1,0,0">
                                    <TextBlock x:Name="CadenceValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                    <Ellipse Style="{StaticResource RowDot}" Fill="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Trittfrequenz" Style="{StaticResource RowLabel}"/>
                                </DockPanel>
                                <DockPanel x:Name="HeartRow" Margin="0,1,0,0">
                                    <TextBlock x:Name="HeartValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                    <Ellipse Style="{StaticResource RowDot}" Fill="{DynamicResource NegativeBrush}"/>
                                    <TextBlock Text="Puls" Style="{StaticResource RowLabel}"/>
                                </DockPanel>
                                <DockPanel Margin="0,1,0,0">
                                    <TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                    <Ellipse Style="{StaticResource RowDot}" Fill="{DynamicResource PositiveBrush}"/>
                                    <TextBlock Text="Geschwindigkeit" Style="{StaticResource RowLabel}"/>
                                </DockPanel>
                                <DockPanel Margin="0,1,0,0">
                                    <TextBlock x:Name="DistanceValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                    <Ellipse Style="{StaticResource RowDot}" Fill="{DynamicResource WarningBrush}"/>
                                    <TextBlock Text="Distanz" Style="{StaticResource RowLabel}"/>
                                </DockPanel>
                                <DockPanel x:Name="TimeRow" Margin="0,1,0,0">
                                    <TextBlock x:Name="TimeValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                    <Ellipse Style="{StaticResource RowDot}" Fill="{DynamicResource SubtleBrush}"/>
                                    <TextBlock Text="Fahrzeit" Style="{StaticResource RowLabel}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== Strecke ===== -->
                    <Grid x:Name="RouteView" Visibility="Collapsed">
                        <Border x:Name="RouteEmpty" Style="{StaticResource Card}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SubtleBrush}"/>
                                <TextBlock Text="Keine Strecke geladen" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock Text="GPX-Datei aufs Overlay ziehen oder laden." Style="{StaticResource CardText}" HorizontalAlignment="Center"/>
                                <Button Content="Strecke laden" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,10,0,0" Click="LoadRoute_Click"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="RouteLoaded" Visibility="Collapsed">
                            <Grid x:Name="RouteGraphics" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="5">
                                    <Canvas Width="86" Height="86">
                                        <Polyline x:Name="MapLine" StrokeThickness="1.5" Stroke="{DynamicResource SubtleBrush}" StrokeLineJoin="Round"/>
                                        <Ellipse x:Name="MapDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
                                    </Canvas>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8,5" Margin="8,0,0,0">
                                    <Canvas Width="194" Height="86">
                                        <Polygon x:Name="ProfileArea" Fill="{DynamicResource ProfileFillBrush}"/>
                                        <Polyline x:Name="ProfileLine" StrokeThickness="1.5" Stroke="{DynamicResource SubtleBrush}" StrokeLineJoin="Round"/>
                                        <Ellipse x:Name="ProfileDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
                                    </Canvas>
                                </Border>
                            </Grid>
                            <Grid Margin="2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="RouteNameText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="RouteDistanceValue" Style="{StaticResource Value}" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="STEIGUNG" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="GradeValue" Style="{StaticResource Value}" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SPEED" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="RouteSpeedValue" Style="{StaticResource Value}" FontSize="14"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource ChipBrush}" Margin="2,8,2,0">
                                <Rectangle RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ===== ERG ===== -->
                    <Border x:Name="ErgView" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <Border x:Name="ModeChip" DockPanel.Dock="Right" CornerRadius="6" Padding="7,1" Background="{DynamicResource ChipBrush}">
                                    <TextBlock x:Name="ModeText" FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="ZIELLEISTUNG" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource RoundButton}" Content="−" ToolTip="−10 W (Strg+Alt+Bild↓)" Click="PowerDown_Click" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Style="{DynamicResource BigNumber}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Run x:Name="ErgRun" Text="–"/><Run Text=" W" FontSize="15"/>
                                </TextBlock>
                                <Button Grid.Column="2" Style="{StaticResource RoundButton}" Content="+" ToolTip="+10 W (Strg+Alt+Bild↑)" Click="PowerUp_Click" VerticalAlignment="Center"/>
                            </Grid>
                            <Button x:Name="ErgToggleButton" Style="{StaticResource AccentButton}" Content="ERG starten" Margin="0,10,0,0" Click="ErgToggle_Click"/>
                            <TextBlock x:Name="ErgHint" Style="{StaticResource CardText}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Meldung: liegt über der aktuellen Ansicht, verschwindet von selbst ===== -->
                    <Border x:Name="Toast" Visibility="Collapsed" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource ToastBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="16,12" MouseLeftButtonDown="Toast_Click" Cursor="Hand">
                        <DockPanel VerticalAlignment="Center">
                            <local:Avatar x:Name="ToastAvatar" Width="72" Height="58" Margin="0,0,16,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ToastTitle" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ToastText" Style="{StaticResource CardText}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
