<Window x:Class="Domestique.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Domestique.App"
        Title="Domestique" Width="773" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" AllowDrop="True"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Drop="Window_Drop" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <!-- soft glow at the bottom edge of the Bluetooth card -->
        <RadialGradientBrush x:Key="GlowMask">
            <GradientStop Color="#C0000000" Offset="0"/>
            <GradientStop Color="#50000000" Offset="0.5"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </RadialGradientBrush>

        <!-- right edge that lights up on hover (expand/collapse the map) -->
        <LinearGradientBrush x:Key="EdgeGlow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#24FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- HUD text on its Figma baseline: WPF puts this font's baseline at 1.035 × size, Figma at 0.878 × size -->
        <Style x:Key="HudText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource HudFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <!-- top values: number 29.76 and unit 9.92 on the same baseline (39.1) -->
        <Style x:Key="StatNumber" TargetType="TextBlock" BasedOn="{StaticResource HudText}">
            <Setter Property="FontSize" Value="29.76"/>
            <Setter Property="Margin" Value="0,8.33,0,0"/>
        </Style>
        <Style x:Key="StatUnit" TargetType="TextBlock" BasedOn="{StaticResource HudText}">
            <Setter Property="FontSize" Value="9.92"/>
            <Setter Property="Margin" Value="0,28.8,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- small label on the map card, baseline 21.8 -->
        <Style x:Key="HudLabel" TargetType="TextBlock" BasedOn="{StaticResource HudText}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="13,11.45,13,0"/>
        </Style>
        <Style x:Key="HudIcon" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <!-- icon above the unit, bottom-aligned at 28 -->
        <Style x:Key="StatIcon" TargetType="Path" BasedOn="{StaticResource HudIcon}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- small notch: all numbers as large as the watts (21), icons centered on the number -->
        <Style x:Key="MiniSlot" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="MiniFit" TargetType="Viewbox">
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MiniNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource HudFont}"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>
        <Style x:Key="MiniIcon" TargetType="Path" BasedOn="{StaticResource HudIcon}">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
    </Window.Resources>

    <!-- 14 px per side for the notch ears; 12 px transparent bottom margin for the open spring (clicks pass through) -->
    <!-- The island sits top center; the ears stay attached to it, also when minimized. -->
    <Grid x:Name="Root" Margin="0,0,0,12">
      <Grid x:Name="IslandGrid" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="14"/>
        </Grid.ColumnDefinitions>
        <Path x:Name="LeftEar" Data="M0,0 L14,0 L14,14 A14,14 0 0 0 0,0 Z" VerticalAlignment="Top" Visibility="Collapsed"/>
        <Path x:Name="RightEar" Grid.Column="2" Data="M14,0 L0,0 L0,14 A14,14 0 0 1 14,0 Z" VerticalAlignment="Top" Visibility="Collapsed"/>

        <!-- Notch as in the design: 401 × 200, header from 7, HUD card from 42, 10 padding -->
        <Border x:Name="Shell" Grid.Column="1" Width="401" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource ShellRadius}" Padding="10,7,10,10">
            <Border.ContextMenu>
                <!-- headers with shortcuts are set when the menu opens -->
                <ContextMenu Opened="ContextMenu_Opened">
                    <MenuItem Header="Load route …" Click="LoadRoute_Click"/>
                    <MenuItem Header="Export ride" Click="Export_Click"/>
                    <MenuItem x:Name="ErgMenuItem" Header="Start ERG" Click="ErgToggle_Click"/>
                    <MenuItem x:Name="SettingsMenuItem" Header="Settings" Click="SettingsMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Quit" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
            <StackPanel x:Name="Expanded">
                <!-- == Header: views left, tools right == -->
                <Grid x:Name="Header" Height="26">
                    <Grid x:Name="TabBar" HorizontalAlignment="Left">
                        <!-- the selection glides to the chosen tab -->
                        <Border x:Name="TabPill" Width="34" Height="26" CornerRadius="13" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource ChipBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="HomeTab" Style="{StaticResource NavTab}" Content="&#xE80F;" ToolTip="Overview" IsChecked="True" Checked="Tab_Checked"/>
                            <RadioButton x:Name="RouteTab" Style="{StaticResource NavTab}" Content="&#xE707;" ToolTip="Route" Checked="Tab_Checked"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- link state and number of connected devices; click opens the Bluetooth settings -->
                        <Button x:Name="LinkButton" Style="{StaticResource LinkPill}" Click="LinkButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LinkDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="LinkCount" Text="0" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="ClickThroughButton" Style="{StaticResource NavButton}" Click="ClickThrough_Click">
                            <Path Data="M0,0 L0,12.5 L3.4,9.4 L5.8,14.6 L8,13.6 L5.6,8.5 L10.2,8.5 Z" Height="13" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <!-- minimize to the small notch -->
                        <Button x:Name="MinimizeButton" Style="{StaticResource NavButton}" Content="&#xE70E;" ToolTip="Minimize" Click="Minimize_Click"/>
                        <Button x:Name="SettingsButton" Style="{StaticResource NavButton}" Content="&#xE713;" Click="SettingsMenu_Click"/>
                    </StackPanel>
                    <!-- short notices centered in the header, on their own surface so longer texts stay readable over the tabs -->
                    <Border x:Name="NoticeBar" Height="26" CornerRadius="13" Padding="11,0,12,0" HorizontalAlignment="Center"
                            Opacity="0" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="NoticeDot" Width="6" Height="6" Margin="0,1,7,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="NoticeText" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- inactive views are Hidden so tab switches never resize the window; the clip reaches 8 px into the padding for overshoot -->
                <Grid x:Name="Views" Margin="-8,0,-8,-8" ClipToBounds="True">
                <Grid x:Name="ViewsArea" Margin="8,9,8,8">

                    <!-- == Overview: HUD as in the Figma design, expandable map and gradient profile to the right == -->
                    <Grid x:Name="HomeView" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="381"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- HUD card 381 × 148: margins are Figma coordinates from the outer edge (Margin -1 cancels the border) -->
                        <Border x:Name="RideCard" Style="{StaticResource Card}" Height="148" Padding="0">
                            <Grid Margin="-1">
                                <!-- top values spread over the width; long values shrink the row (at least 12 px between values) -->
                                <Viewbox Margin="13,0,13,0" StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Grid x:Name="TopStats" MinWidth="355">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" Background="Transparent" ToolTip="Speed">
                                        <TextBlock Style="{StaticResource StatNumber}"><Run x:Name="SpeedRun" Text="–"/></TextBlock>
                                        <Grid Margin="1.6,0,0,0">
                                            <Path x:Name="SpeedIcon" Style="{StaticResource StatIcon}" Width="10.17" Height="7.19" Margin="0,20.81,0,0"/>
                                            <TextBlock Text="KM/H" Style="{StaticResource StatUnit}"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" Background="Transparent" ToolTip="Distance">
                                        <TextBlock Style="{StaticResource StatNumber}"><Run x:Name="DistanceRun" Text="–"/></TextBlock>
                                        <Grid Margin="1.6,0,0,0">
                                            <Path x:Name="DistanceIcon" Style="{StaticResource StatIcon}" Width="10.42" Height="7.94" Margin="0,20.06,0,0"/>
                                            <TextBlock Text="KM" Style="{StaticResource StatUnit}"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,12,0" Background="Transparent" ToolTip="Elevation gain">
                                        <TextBlock Style="{StaticResource StatNumber}"><Run x:Name="ClimbRun" Text="–"/></TextBlock>
                                        <Grid Margin="1.6,0,0,0">
                                            <Path x:Name="ClimbIcon" Style="{StaticResource StatIcon}" Width="9.67" Height="8.43" Margin="0,19.57,0,0"/>
                                            <TextBlock Text="M" Style="{StaticResource StatUnit}"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Background="Transparent" ToolTip="Elapsed time">
                                        <TextBlock Style="{StaticResource StatNumber}"><Run x:Name="TimeRun" Text="–"/></TextBlock>
                                        <Grid Margin="1.6,0,0,0">
                                            <Path x:Name="TimeIcon" Style="{StaticResource StatIcon}" Width="10.42" Height="10.42" Margin="0,17.58,0,0"/>
                                            <TextBlock Text="ET" Style="{StaticResource StatUnit}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                </Viewbox>

                                <!-- route progress; without a route just the dark track as a divider -->
                                <Border Margin="13,45,14,0" Height="6" VerticalAlignment="Top" CornerRadius="3" Background="{DynamicResource TrackBrush}">
                                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="1.5" Background="{DynamicResource TextBrush}"/>
                                </Border>

                                <!-- avatar (body 74 × 59 as in the design) with the FTP power zone below; reacts to hover and tap -->
                                <local:Avatar x:Name="Mascot" Width="96" Height="81" Margin="5,45.6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              IsHitTestVisible="True" MouseEnter="Mascot_MouseEnter" MouseLeave="Mascot_MouseLeave" MouseLeftButtonDown="Mascot_Poke"/>
                                <StackPanel x:Name="ZoneBar" Orientation="Horizontal" Margin="18,129,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Border Width="10" Height="6" CornerRadius="3" Margin="0,0,2,0"/>
                                    <Border Width="10" Height="6" CornerRadius="3" Margin="0,0,2,0"/>
                                    <Border Width="10" Height="6" CornerRadius="3" Margin="0,0,2,0"/>
                                    <Border Width="10" Height="6" CornerRadius="3" Margin="0,0,2,0"/>
                                    <Border Width="10" Height="6" CornerRadius="3" Margin="0,0,2,0"/>
                                    <Border Width="10" Height="6" CornerRadius="3"/>
                                </StackPanel>

                                <Grid Margin="106,0,25,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- watts 16 px right of the avatar; bolt and w follow with 2 px; four digits shrink instead of overlapping -->
                                    <Grid Height="89.1" Margin="0,40.62,6,0" VerticalAlignment="Top">
                                        <Viewbox x:Name="PowerColumn" StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{DynamicResource BigNumber}" FontSize="66.1"><Run x:Name="PowerRun" Text="0"/></TextBlock>
                                                <Grid x:Name="PowerUnit" Width="29" Margin="2,0,0,0">
                                                    <Path x:Name="BoltIcon" Style="{StaticResource HudIcon}" Width="16.38" Height="25.9" Margin="0,21.5,0,0" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="w" Style="{DynamicResource BigNumber}" FontSize="29.74" Margin="0,38.5,0,0"
                                                               VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Viewbox>
                                    </Grid>

                                    <!-- heart rate and cadence right-aligned, icon top right of the number with 1.6 px spacing like the units above -->
                                    <Grid x:Name="SideColumn" Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,54.26,0,0"
                                                    Background="Transparent" ToolTip="Heart rate (bpm)">
                                            <TextBlock Style="{DynamicResource BigNumber}" FontSize="29.74"><Run x:Name="HeartRun" Text="0"/></TextBlock>
                                            <Path x:Name="HeartIcon" Style="{StaticResource HudIcon}" Width="11.02" Height="9.92" Margin="1.6,14.18,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,82.27,0,0"
                                                    Background="Transparent" ToolTip="Cadence (rpm)">
                                            <TextBlock Style="{DynamicResource BigNumber}" FontSize="29.74"><Run x:Name="CadenceRun" Text="0"/></TextBlock>
                                            <Path x:Name="CadenceIcon" Style="{StaticResource HudIcon}" Width="11.57" Height="11.57" Margin="1.6,14.71,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- ERG: on with the target in watts, otherwise "ERG OFF" -->
                                <Border x:Name="ErgPill" Margin="113,119,0,0" Height="16" CornerRadius="8" Padding="7,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}">
                                    <TextBlock x:Name="ErgPillText" Text="ERG OFF" FontFamily="{DynamicResource HudFont}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource OnAccentBrush}" TextOptions.TextFormattingMode="Ideal"/>
                                </Border>

                                <!-- not a button: with a route the right edge lights up on hover; a click expands the map -->
                                <Border x:Name="MapOpener" Width="14" HorizontalAlignment="Right" Background="Transparent" Cursor="Hand" Visibility="Collapsed"
                                        ToolTip="Show map" MouseEnter="MapEdge_MouseEnter" MouseLeave="MapEdge_MouseLeave" MouseLeftButtonDown="MapEdge_Click">
                                    <Border CornerRadius="0,15,15,0" Opacity="0" IsHitTestVisible="False" Background="{StaticResource EdgeGlow}">
                                        <Path Data="M0,0 L3.5,4 L0,8" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- map and gradient profile, as tall as the HUD; its right edge collapses it again -->
                        <Border x:Name="MapCard" Grid.Column="1" Style="{StaticResource Card}" Width="320" Height="148" Margin="8,0,0,0" Padding="0"
                                Visibility="Collapsed">
                            <Grid Margin="-1">
                                <TextBlock x:Name="RouteNameText" Style="{StaticResource HudLabel}" Margin="13,11.45,112,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="RouteDistanceText" Style="{StaticResource HudLabel}" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SubtleBrush}"/>
                                <!-- ridden part in the accent color -->
                                <Canvas Width="102" Height="102" Margin="13,33,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Polyline x:Name="MapLine" StrokeThickness="1.5" Stroke="{DynamicResource SubtleBrush}" StrokeLineJoin="Round" Opacity="0.7"/>
                                    <Polyline x:Name="MapDone" StrokeThickness="2.5" Stroke="{DynamicResource AccentBrush}" StrokeLineJoin="Round"/>
                                    <Ellipse x:Name="MapDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
                                </Canvas>
                                <local:GradientProfile x:Name="Profile" Margin="127,33,16,13"/>
                                <Border x:Name="MapCloser" Width="14" HorizontalAlignment="Right" Background="Transparent" Cursor="Hand"
                                        ToolTip="Hide map" MouseEnter="MapEdge_MouseEnter" MouseLeave="MapEdge_MouseLeave" MouseLeftButtonDown="MapEdge_Click">
                                    <Border CornerRadius="0,15,15,0" Opacity="0" IsHitTestVisible="False" Background="{StaticResource EdgeGlow}">
                                        <Path Data="M3.5,0 L0,4 L3.5,8" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- == Route view: add a file or pick from the library, confirm top right == -->
                    <Grid x:Name="RouteView" Visibility="Hidden">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel x:Name="RouteBar" Margin="0,0,0,6">
                            <Button x:Name="ConfirmRouteButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Use route"
                                    Padding="14,4" Margin="8,0,0,0" Click="ConfirmRoute_Click"/>
                            <Border x:Name="SourceBar" DockPanel.Dock="Right" Style="{StaticResource SegmentBar}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="OwnRoutesSegment" Style="{StaticResource Segment}" GroupName="RouteSource" Content="Mine" IsChecked="True" Checked="RouteSource_Checked"/>
                                    <RadioButton x:Name="AppRoutesSegment" Style="{StaticResource Segment}" GroupName="RouteSource" Content="Built-in" Checked="RouteSource_Checked"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="AddSegment" Style="{StaticResource Segment}" GroupName="RouteMode" Content="Add" Checked="RouteMode_Checked"/>
                                    <RadioButton x:Name="LibrarySegment" Style="{StaticResource Segment}" GroupName="RouteMode" Content="Library" IsChecked="True" Checked="RouteMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- add: drop a file on the overlay or choose one -->
                        <Grid x:Name="AddPanel" Grid.Row="1" Visibility="Collapsed">
                            <Rectangle RadiusX="12" RadiusY="12" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"
                                       Fill="{DynamicResource CardBrush}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="24" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleBrush}" Margin="0,0,14,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Drop a GPX file here" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="It goes to your library." Style="{StaticResource CardText}"/>
                                </StackPanel>
                                <Button Content="Choose file" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Margin="18,0,0,0" Click="PickRouteFile_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- library: own or built-in routes in two columns, "No route" first -->
                        <ListBox x:Name="RouteList" Grid.Row="1" Style="{StaticResource CompactList}" MouseDoubleClick="ConfirmRoute_Click">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" Margin="0,1,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- == Bluetooth off: stays until tapped (Windows settings) or Bluetooth is switched on == -->
                    <Border x:Name="BluetoothCard" Visibility="Collapsed" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource ToastBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" MouseLeftButtonDown="BluetoothCard_Click" Cursor="Hand">
                        <Grid ClipToBounds="True">
                            <Ellipse x:Name="BluetoothGlow" Width="360" Height="110" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-62"
                                     Opacity="0" IsHitTestVisible="False" OpacityMask="{StaticResource GlowMask}" Fill="{DynamicResource NegativeBrush}"/>
                            <DockPanel Margin="12,12,16,12" VerticalAlignment="Center">
                                <local:Avatar x:Name="BluetoothAvatar" Width="96" Height="81" Margin="0,0,12,0"/>
                                <StackPanel x:Name="BluetoothText" VerticalAlignment="Center">
                                    <TextBlock Text="Bluetooth is off" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Tap to turn it on. I'll connect by myself."
                                               Style="{StaticResource CardText}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>


                </Grid>
                </Grid>
            </StackPanel>

            <!-- == Small notch: avatar and the chosen values, same font and icons as the HUD == -->
            <DockPanel x:Name="CompactBar" Height="36" Visibility="Collapsed" ClipToBounds="True">
                <local:Avatar x:Name="MiniMascot" Width="38" Height="31" Margin="0,0,9,0" VerticalAlignment="Center" IsHitTestVisible="True"
                              MouseEnter="Mascot_MouseEnter" MouseLeave="Mascot_MouseLeave" MouseLeftButtonDown="Mascot_Poke"/>
                <Button x:Name="ExpandButton" DockPanel.Dock="Right" Style="{StaticResource NavButton}" Content="&#xE70D;" ToolTip="Expand"
                        VerticalAlignment="Center" Click="Expand_Click"/>
                <!-- fixed slots for jumping values (icons stay put), value-sized slots for growing ones (FitCompactSlots) -->
                <StackPanel x:Name="CompactValues" Orientation="Horizontal">
                    <DockPanel Style="{StaticResource MiniSlot}" Tag="Power" Width="51.8" ToolTip="Power (W)">
                        <Path x:Name="MiniBoltIcon" Style="{StaticResource MiniIcon}" Width="7.78" Height="12.3"/>
                        <Viewbox Style="{StaticResource MiniFit}"><TextBlock Style="{StaticResource MiniNumber}"><Run x:Name="MiniPowerRun" Text="0"/></TextBlock></Viewbox>
                    </DockPanel>
                    <DockPanel Style="{StaticResource MiniSlot}" Tag="HeartRate" Width="53.4" ToolTip="Heart rate (bpm)">
                        <Path x:Name="MiniHeartIcon" Style="{StaticResource MiniIcon}" Width="9.37" Height="8.43"/>
                        <Viewbox Style="{StaticResource MiniFit}"><TextBlock Style="{StaticResource MiniNumber}"><Run x:Name="MiniHeartRun" Text="0"/></TextBlock></Viewbox>
                    </DockPanel>
                    <DockPanel Style="{StaticResource MiniSlot}" Tag="Cadence" Width="53.8" ToolTip="Cadence (rpm)">
                        <Path x:Name="MiniCadenceIcon" Style="{StaticResource MiniIcon}" Width="9.83" Height="9.83"/>
                        <Viewbox Style="{StaticResource MiniFit}"><TextBlock Style="{StaticResource MiniNumber}"><Run x:Name="MiniCadenceRun" Text="0"/></TextBlock></Viewbox>
                    </DockPanel>
                    <DockPanel Style="{StaticResource MiniSlot}" Tag="Speed" Width="38.7" ToolTip="Speed (km/h)">
                        <Path x:Name="MiniSpeedIcon" Style="{StaticResource MiniIcon}" Width="8.64" Height="6.11"/>
                        <Viewbox Style="{StaticResource MiniFit}"><TextBlock Style="{StaticResource MiniNumber}"><Run x:Name="MiniSpeedRun" Text="0"/></TextBlock></Viewbox>
                    </DockPanel>
                    <DockPanel x:Name="DistanceSlot" Style="{StaticResource MiniSlot}" Tag="Distance" Width="38.9" ToolTip="Distance (km)">
                        <Path x:Name="MiniDistanceIcon" Style="{StaticResource MiniIcon}" Width="8.86" Height="6.75"/>
                        <Viewbox Style="{StaticResource MiniFit}"><TextBlock Style="{StaticResource MiniNumber}"><Run x:Name="MiniDistanceRun" Text="0.0"/></TextBlock></Viewbox>
                    </DockPanel>
                    <DockPanel x:Name="ClimbSlot" Style="{StaticResource MiniSlot}" Tag="Climb" Width="24.2" ToolTip="Elevation gain (m)">
                        <Path x:Name="MiniClimbIcon" Style="{StaticResource MiniIcon}" Width="8.22" Height="7.17"/>
                        <Viewbox Style="{StaticResource MiniFit}"><TextBlock Style="{StaticResource MiniNumber}"><Run x:Name="MiniClimbRun" Text="0"/></TextBlock></Viewbox>
                    </DockPanel>
                    <DockPanel x:Name="TimeSlot" Style="{StaticResource MiniSlot}" Tag="Time" Width="59.9" ToolTip="Elapsed time">
                        <Path x:Name="MiniTimeIcon" Style="{StaticResource MiniIcon}" Width="8.86" Height="8.86"/>
                        <Viewbox Style="{StaticResource MiniFit}"><TextBlock Style="{StaticResource MiniNumber}"><Run x:Name="MiniTimeRun" Text="0:00"/></TextBlock></Viewbox>
                    </DockPanel>
                </StackPanel>
            </DockPanel>

            <!-- launch animation: draws card, particles and the avatar while the launch runs -->
            <local:GreetingView x:Name="Greeting" Margin="-10,-7,-10,-10" Visibility="Collapsed"/>
            <!-- route loaded: transition where the avatar rides a straight line with a few stones -->
            <local:RideView x:Name="Ride" Margin="-10,-7,-10,-10" Visibility="Collapsed"/>
            </Grid>
        </Border>
      </Grid>
    </Grid>
</Window>
