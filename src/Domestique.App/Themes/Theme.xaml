<!-- Colors, fonts and radii. Card and notch sizes follow the Figma design (notch 401 × 200, HUD card 381 × 148). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- == Colors == -->
    <Color x:Key="SurfaceColor">#0B0C0F</Color>
    <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#121317"/>
    <SolidColorBrush x:Key="CardBrush" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#1EFFFFFF"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#0B0C0F"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#9399A3"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#4A4F58"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3D7BFA"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E3D7BFA"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PositiveBrush" Color="#34D27B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5B83D"/>
    <SolidColorBrush x:Key="NegativeBrush" Color="#F0524D"/>
    <LinearGradientBrush x:Key="ToastBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1B21" Offset="0"/>
        <GradientStop Color="#3A2236" Offset="1"/>
    </LinearGradientBrush>

    <!-- == Fonts == -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="LabelFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="NumberFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="HudFont">pack://application:,,,/Domestique;component/Fonts/#Archivo Black</FontFamily>
    <FontWeight x:Key="NumberWeight">SemiBold</FontWeight>

    <!-- == Shapes == -->
    <CornerRadius x:Key="ShellRadius">21</CornerRadius>
    <CornerRadius x:Key="CardRadius">15</CornerRadius>

    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudFont}"/>
        <Setter Property="FontSize" Value="38"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
</ResourceDictionary>
