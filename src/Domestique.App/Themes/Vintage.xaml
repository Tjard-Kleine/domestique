<!-- Stil „Vintage“ wie im Figma-Entwurf „Finished Design – RETRO“: dunkles Panel wie Standard, dazu vier Renn-Farbstreifen
     (blau, rot, creme, gelb), die unten rechts schräg durch die HUD-Karte laufen. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Color x:Key="SurfaceColor">#0B0C0F</Color>
    <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#121317"/>
    <SolidColorBrush x:Key="CardBrush" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#1EFFFFFF"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#0B0C0F"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#9399A3"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#4A4F58"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3D7BFA"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E3D7BFA"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PositiveBrush" Color="#34D27B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5B83D"/>
    <SolidColorBrush x:Key="NegativeBrush" Color="#F0524D"/>
    <LinearGradientBrush x:Key="ToastBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1B21" Offset="0"/>
        <GradientStop Color="#3A2236" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AvatarBodyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#D9DDE6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AvatarEyeBrush" Color="#16171B"/>
    <SolidColorBrush x:Key="AvatarCheekBrush" Color="#70FF8FA6"/>

    <SolidColorBrush x:Key="Stripe1Brush" Color="#008FFD"/>
    <SolidColorBrush x:Key="Stripe2Brush" Color="#FC2E24"/>
    <SolidColorBrush x:Key="Stripe3Brush" Color="#FDFEEA"/>
    <SolidColorBrush x:Key="Stripe4Brush" Color="#FDC100"/>
    <Visibility x:Key="StripeVisibility">Visible</Visibility>
    <Visibility x:Key="AccentBarVisibility">Collapsed</Visibility>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="LabelFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="NumberFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="HudFont">pack://application:,,,/Domestique.App;component/Fonts/#Archivo Black</FontFamily>
    <FontWeight x:Key="NumberWeight">SemiBold</FontWeight>
    <sys:Double x:Key="HeroNumberSize">66.1</sys:Double>   <!-- große Wattzahl auf der Übersicht -->
    <sys:Double x:Key="SideNumberSize">29.74</sys:Double>  <!-- Puls und Kadenz neben der Wattzahl -->
    <sys:Double x:Key="UnitSize">29.74</sys:Double>        <!-- das w unter dem Blitz -->
    <sys:Double x:Key="MinOpacity">0.2</sys:Double>
    <CornerRadius x:Key="ShellRadius">21</CornerRadius>
    <CornerRadius x:Key="CardRadius">15</CornerRadius>

    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudFont}"/>
        <Setter Property="FontSize" Value="38"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
</ResourceDictionary>
