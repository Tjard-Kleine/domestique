<!-- Stil „Tour“: TV-Grafik der großen Rundfahrten. Nachtblau, Maillot-Gelb, schmale kursive Zahlen, gelber Balken. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Color x:Key="SurfaceColor">#0A1022</Color>
    <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#0E152B"/>
    <SolidColorBrush x:Key="CardBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#2AFFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#9CA6BC"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#3E4860"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFD400"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#33FFD400"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#111111"/>
    <SolidColorBrush x:Key="PositiveBrush" Color="#2BD67B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9F1C"/>
    <SolidColorBrush x:Key="NegativeBrush" Color="#FF4D4D"/>
    <LinearGradientBrush x:Key="ToastBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E152B" Offset="0"/>
        <GradientStop Color="#1C3A7A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AvatarBodyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#DCE1EC" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProfileFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#70FFD400" Offset="0"/>
        <GradientStop Color="#05FFD400" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AvatarEyeBrush" Color="#0A1022"/>
    <SolidColorBrush x:Key="AvatarCheekBrush" Color="#70FFC94D"/>

    <SolidColorBrush x:Key="Stripe1Brush" Color="#FFD400"/>
    <SolidColorBrush x:Key="Stripe2Brush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Stripe3Brush" Color="#FFD400"/>
    <SolidColorBrush x:Key="Stripe4Brush" Color="#FFFFFF"/>
    <Visibility x:Key="StripeVisibility">Collapsed</Visibility>
    <Visibility x:Key="AccentBarVisibility">Visible</Visibility>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="LabelFont">Bahnschrift</FontFamily>
    <FontFamily x:Key="NumberFont">Bahnschrift</FontFamily>
    <FontWeight x:Key="NumberWeight">Bold</FontWeight>
    <sys:Double x:Key="HeroNumberSize">52</sys:Double>   <!-- große Wattzahl auf der Übersicht -->
    <sys:Double x:Key="MinOpacity">0.2</sys:Double>
    <CornerRadius x:Key="ShellRadius">14</CornerRadius>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>

    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStretch" Value="Condensed"/>
        <Setter Property="FontSize" Value="42"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <SkewTransform AngleX="-9"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
