<!-- Einstellungen als Popover im Stil des macOS-Vorbilds: Icon-Reiter, Karten mit Symbol, Titel, Text und Schalter.
     Jede Änderung wirkt sofort, es gibt kein „Übernehmen“. -->
<Window x:Class="Domestique.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Domestique.App"
        Title="Domestique – Einstellungen" Width="408" Height="712"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Panel 380 × 640. Der durchsichtige Rand (PadX, PadY) ist Platz zum Nachfedern beim Öffnen; dort gehen Klicks durch. -->
    <Border x:Name="Popover" Margin="14,36" CornerRadius="18" Background="{DynamicResource SurfaceSolidBrush}" BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1" Padding="14">
        <DockPanel>
            <!-- Kopf: Avatar, Titel, Schließen. Zum Verschieben hier ziehen. -->
            <Grid DockPanel.Dock="Top" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <local:Avatar x:Name="HeaderAvatar" Width="40" Height="32" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Domestique" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="Einstellungen" FontSize="11" Foreground="{DynamicResource SubtleBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource NavButton}" Content="&#xE711;" ToolTip="Schließen" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="Close_Click"/>
            </Grid>

            <Border DockPanel.Dock="Top" CornerRadius="13" Background="{DynamicResource CardBrush}" Padding="2" Margin="0,0,0,4">
                <Grid>
                    <!-- Auswahl gleitet zum gewählten Reiter und federt nach -->
                    <Border x:Name="TabPill" Height="36" Margin="3" CornerRadius="10" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"/>
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="LookTab" Style="{StaticResource SettingsTab}" Content="&#xE790;" ToolTip="Darstellung" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="RiderTab" Style="{StaticResource SettingsTab}" Content="&#xE77B;" ToolTip="Fahrer" Checked="Tab_Checked"/>
                        <RadioButton x:Name="BluetoothTab" Style="{StaticResource SettingsTab}" Content="&#xE702;" ToolTip="Bluetooth" Checked="Tab_Checked"/>
                        <RadioButton x:Name="LibraryTab" Style="{StaticResource SettingsTab}" Content="&#xE8F1;" ToolTip="Bibliothek" Checked="Tab_Checked"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <Grid>
                <!-- ===== Darstellung ===== -->
                <ScrollViewer x:Name="LookPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="STIL" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SettingCard}" Padding="9,10">
                            <UniformGrid Columns="3">
                                <!-- Vorschauen mit festen Farben, damit man alle drei nebeneinander vergleichen kann -->
                                <RadioButton x:Name="StandardTile" Style="{StaticResource StyleTile}" Tag="Standard" Checked="Theme_Checked">
                                    <Border Height="62" CornerRadius="9" Background="#0B0C0F" Padding="8,6">
                                        <StackPanel>
                                            <Ellipse Width="6" Height="6" Fill="#3D7BFA" HorizontalAlignment="Right"/>
                                            <TextBlock Text="213" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" FontSize="20" Foreground="#F3F4F6"/>
                                            <Border Height="3" CornerRadius="1.5" Background="#3D7BFA" Width="30" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </RadioButton>
                                <RadioButton x:Name="TourTile" Style="{StaticResource StyleTile}" Tag="Tour" Checked="Theme_Checked">
                                    <Border Height="62" CornerRadius="9" Background="#0A1022" Padding="8,6">
                                        <StackPanel>
                                            <Ellipse Width="6" Height="6" Fill="#FFD400" HorizontalAlignment="Right"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="3" Height="18" Fill="#FFD400" Margin="0,0,5,0" RadiusX="1.5" RadiusY="1.5"/>
                                                <TextBlock Text="213" FontFamily="Bahnschrift" FontWeight="Bold" FontStretch="Condensed" FontSize="21" Foreground="White">
                                                    <TextBlock.RenderTransform><SkewTransform AngleX="-9"/></TextBlock.RenderTransform>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Height="3" CornerRadius="1.5" Background="#FFD400" Width="30" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </RadioButton>
                                <RadioButton x:Name="VintageTile" Style="{StaticResource StyleTile}" Tag="Vintage" Checked="Theme_Checked">
                                    <Border Height="62" CornerRadius="9" Background="#EFE6D2" Padding="0,6,8,6">
                                        <StackPanel>
                                            <Ellipse Width="6" Height="6" Fill="#D4502E" HorizontalAlignment="Right"/>
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Width="18" VerticalAlignment="Center" Margin="0,2,5,0">
                                                    <Rectangle Height="3" Fill="#2E64AE"/>
                                                    <Rectangle Height="3" Fill="#D8382E"/>
                                                    <Rectangle Height="3" Fill="#EE8A2A"/>
                                                    <Rectangle Height="3" Fill="#F3C143"/>
                                                </StackPanel>
                                                <TextBlock Text="213" FontFamily="Georgia" FontWeight="Bold" FontSize="19" Foreground="#2A211B"/>
                                            </StackPanel>
                                            <Border Height="3" CornerRadius="1.5" Background="#D4502E" Width="30" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </RadioButton>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="OVERLAY" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE706;" Style="{StaticResource IconGlyph}"/></Border>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Text="Deckkraft" Style="{StaticResource CardTitle}"/>
                                    </DockPanel>
                                    <TextBlock Text="Vintage bleibt fast deckend, damit die dunkle Schrift lesbar ist." Style="{StaticResource CardText}"/>
                                    <Slider x:Name="OpacitySlider" Style="{StaticResource ModernSlider}" Minimum="20" Maximum="100" Margin="0,4,0,0" ValueChanged="Look_Changed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE740;" Style="{StaticResource IconGlyph}"/></Border>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Text="Größe" Style="{StaticResource CardTitle}"/>
                                    </DockPanel>
                                    <Slider x:Name="ScaleSlider" Style="{StaticResource ModernSlider}" Minimum="0.7" Maximum="1.6" Margin="0,4,0,0" ValueChanged="Look_Changed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE718;" Style="{StaticResource IconGlyph}"/></Border>
                                <CheckBox x:Name="NotchBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0" Click="Look_Changed"/>
                                <StackPanel>
                                    <TextBlock Text="Oben andocken" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="An den oberen Rand ziehen: Das Overlay hängt dort wie eine Notch. Verschieben geht weiterhin." Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE707;" Style="{StaticResource IconGlyph}"/></Border>
                                <CheckBox x:Name="ShowMapBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0" Click="Look_Changed"/>
                                <StackPanel>
                                    <TextBlock Text="Karte und Höhenprofil" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Auf der Übersicht, sobald eine Strecke gewählt ist. Aus: nur Kilometer, Steigung und Speed." Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}"/></Border>
                                <Button DockPanel.Dock="Right" Content="Zurücksetzen" Style="{StaticResource PillButton}" VerticalAlignment="Center" Click="ResetPosition_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Position" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Zurück an den Standardplatz." Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Fahrer ===== -->
                <ScrollViewer x:Name="RiderPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="FAHRER" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><TextBlock Text="&#xE945;" Style="{StaticResource IconGlyph}"/></Border>
                                <TextBox x:Name="FtpBox" DockPanel.Dock="Right" Style="{StaticResource InputBox}" Margin="10,0,0,0" TextChanged="Rider_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="FTP in Watt" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><TextBlock Text="&#xE77B;" Style="{StaticResource IconGlyph}"/></Border>
                                <TextBox x:Name="RiderBox" DockPanel.Dock="Right" Style="{StaticResource InputBox}" Margin="10,0,0,0" TextChanged="Rider_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Fahrergewicht in kg" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><TextBlock Text="kg" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBox x:Name="BikeBox" DockPanel.Dock="Right" Style="{StaticResource InputBox}" Margin="10,0,0,0" TextChanged="Rider_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Radgewicht in kg" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><TextBlock Text="Cd" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBox x:Name="CdaBox" DockPanel.Dock="Right" Style="{StaticResource InputBox}" Margin="10,0,0,0" TextChanged="Rider_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CdA in m²" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Etwa 0,32 Oberlenker, 0,25 Zeitfahrhaltung." Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="RiderError" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" Margin="4,0,0,6" Visibility="Collapsed"/>

                        <TextBlock Text="TRAINER" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="DifficultyValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Text="Steigung am Trainer" Style="{StaticResource CardTitle}"/>
                                    </DockPanel>
                                    <TextBlock Text="Anteil der echten Steigung. Zwift-Standard: 50 %." Style="{StaticResource CardText}"/>
                                    <Slider x:Name="DifficultySlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" Margin="0,4,0,0" ValueChanged="Rider_Changed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Bluetooth ===== -->
                <DockPanel x:Name="BluetoothPage" Visibility="Collapsed" Margin="0,0,6,0">
                    <StackPanel DockPanel.Dock="Top">
                        <!-- nur, wenn Bluetooth wirklich aus ist: gleiche Erkennung wie im Overlay -->
                        <Border x:Name="BluetoothOffNotice" Style="{StaticResource SettingCard}" Visibility="Collapsed" Margin="0,8,0,0">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource NegativeBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE702;" Style="{StaticResource IconGlyph}" Foreground="White"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Bluetooth ist aus" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="In den Windows-Einstellungen einschalten" Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="MEINE GERÄTE" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <ListBox x:Name="MyDevicesList" Style="{StaticResource CardList}" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="Status" DockPanel.Dock="Right" Text="Nicht verbunden" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}"
                                                           Margin="0,1,10,0" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource SubtleBrush}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <UniformGrid x:Name="Actions" Columns="2" Margin="0,8,0,0" Visibility="Collapsed">
                                                <Button Content="Verbinden" Style="{StaticResource AccentButton}" Padding="0,6" Margin="0,0,4,0" Click="ConnectSaved_Click"/>
                                                <Button Content="Entfernen" Style="{StaticResource PillButton}" Padding="0,6" Margin="4,0,0,0" Click="ForgetSaved_Click"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter TargetName="Status" Property="Text" Value="Verbunden"/>
                                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource PositiveBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="MyDevicesEmpty" Style="{StaticResource CardText}" Margin="4,0,0,4" Visibility="Collapsed"
                                       Text="Noch keine Geräte. Einmal verbundene Trainer und Pulsgurte erscheinen hier."/>
                        </Grid>

                        <TextBlock Text="ANDERE GERÄTE" Style="{StaticResource SectionHeader}"/>
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Content="Trainer suchen" Style="{StaticResource PillButton}" Margin="0,0,4,0" Click="ScanTrainer_Click"/>
                            <Button Content="Pulsgurt suchen" Style="{StaticResource PillButton}" Margin="4,0,0,0" Click="ScanStrap_Click"/>
                        </UniformGrid>
                        <DockPanel Margin="4,0,0,8">
                            <CheckBox x:Name="AllDevicesBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/>
                            <TextBlock Text="Alle Geräte zeigen (für Trainer, die ihren Dienst nicht ankündigen)" Style="{StaticResource CardText}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock x:Name="BleInfo" DockPanel.Dock="Bottom" Style="{StaticResource CardText}" Margin="4,6,0,0"/>
                    <Grid>
                        <!-- gefundene Geräte: erst nach dem Antippen wählt man, ob Trainer oder Pulsgurt -->
                        <ListBox x:Name="DeviceList" Style="{StaticResource CardList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource SubtleBrush}"/>
                                        <UniformGrid x:Name="Actions" Columns="2" Margin="0,8,0,0" Visibility="Collapsed">
                                            <Button Content="Als Trainer" Style="{StaticResource AccentButton}" Padding="0,6" Margin="0,0,4,0" Click="UseAsTrainer_Click"/>
                                            <Button Content="Als Pulsgurt" Style="{StaticResource AccentButton}" Padding="0,6" Margin="4,0,0,0" Click="UseAsStrap_Click"/>
                                        </UniformGrid>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="DeviceEmpty" Style="{StaticResource CardText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" Text="Gefundene Geräte erscheinen hier.&#10;Der Trainer darf dabei mit keiner anderen App verbunden sein."/>
                    </Grid>
                </DockPanel>

                <!-- ===== Bibliothek ===== -->
                <DockPanel x:Name="LibraryPage" Visibility="Collapsed" Margin="0,0,6,0">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="STRECKEN" Style="{StaticResource SectionHeader}"/>
                    </StackPanel>
                    <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                        <Button Content="Importieren" Style="{StaticResource AccentButton}" Margin="0,0,4,0" Click="Import_Click"/>
                        <Button Content="Laden" Style="{StaticResource PillButton}" Margin="4,0" Click="LoadSelected_Click"/>
                        <Button Content="Löschen" Style="{StaticResource PillButton}" Margin="4,0,0,0" Click="Delete_Click"/>
                    </UniformGrid>
                    <Grid>
                        <ListBox x:Name="LibraryList" Style="{StaticResource CardList}" MouseDoubleClick="LoadSelected_Click">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" Margin="0,1,10,0"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="LibraryEmpty" Text="Noch keine Strecken in der Bibliothek." Style="{StaticResource CardText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
