<!-- Settings popover: icon tabs, cards with icon, title, text and control. Every change applies immediately. -->
<Window x:Class="Domestique.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Domestique.App"
        Title="Domestique – Settings" Width="408" Height="712"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- panel 380 × 640; the transparent margin (PadX, PadY) is room for the open spring, clicks pass through there -->
    <Border x:Name="Popover" Margin="14,36" CornerRadius="18" Background="{DynamicResource SurfaceSolidBrush}" BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1" Padding="14">
        <DockPanel>
            <!-- header: avatar, title, close; drag here to move -->
            <Grid DockPanel.Dock="Top" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <local:Avatar x:Name="HeaderAvatar" Width="50" Height="40" Margin="0,0,8,0" IsHitTestVisible="True"
                                  MouseEnter="Avatar_MouseEnter" MouseLeave="Avatar_MouseLeave" MouseLeftButtonDown="Avatar_Slap"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Domestique" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="Settings" FontSize="11" Foreground="{DynamicResource SubtleBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource NavButton}" Content="&#xE711;" ToolTip="Close" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="Close_Click"/>
            </Grid>

            <Border DockPanel.Dock="Top" CornerRadius="13" Background="{DynamicResource CardBrush}" Padding="2" Margin="0,0,0,4">
                <Grid>
                    <!-- the selection glides to the chosen tab -->
                    <Border x:Name="TabPill" Height="36" Margin="3" CornerRadius="10" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"/>
                    <UniformGrid Columns="5">
                        <RadioButton x:Name="LookTab" Style="{StaticResource SettingsTab}" Content="&#xE790;" ToolTip="Appearance" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="RiderTab" Style="{StaticResource SettingsTab}" Content="&#xE77B;" ToolTip="Rider" Checked="Tab_Checked"/>
                        <RadioButton x:Name="BluetoothTab" Style="{StaticResource SettingsTab}" Content="&#xE702;" ToolTip="Bluetooth" Checked="Tab_Checked"/>
                        <RadioButton x:Name="LibraryTab" Style="{StaticResource SettingsTab}" Content="&#xE8F1;" ToolTip="Library" Checked="Tab_Checked"/>
                        <RadioButton x:Name="KeysTab" Style="{StaticResource SettingsTab}" Content="&#xE765;" ToolTip="Shortcuts" Checked="Tab_Checked"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <Grid>
                <!-- == Appearance == -->
                <ScrollViewer x:Name="LookPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="OVERLAY" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE706;" Style="{StaticResource IconGlyph}"/></Border>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Text="Opacity" Style="{StaticResource CardTitle}"/>
                                    </DockPanel>
                                    <Slider x:Name="OpacitySlider" Style="{StaticResource ModernSlider}" Minimum="20" Maximum="100" Margin="0,4,0,0" ValueChanged="Look_Changed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE740;" Style="{StaticResource IconGlyph}"/></Border>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Text="Size" Style="{StaticResource CardTitle}"/>
                                    </DockPanel>
                                    <Slider x:Name="ScaleSlider" Style="{StaticResource ModernSlider}" Minimum="0.7" Maximum="1.6" Margin="0,4,0,0" ValueChanged="Look_Changed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE718;" Style="{StaticResource IconGlyph}"/></Border>
                                <CheckBox x:Name="NotchBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0" Click="Look_Changed"/>
                                <StackPanel>
                                    <TextBlock Text="Dock at top" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Drag it to the top edge to dock it like a notch." Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE707;" Style="{StaticResource IconGlyph}"/></Border>
                                <CheckBox x:Name="ShowMapBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0" Click="Look_Changed"/>
                                <StackPanel>
                                    <TextBlock Text="Map and profile" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Shown on the overview when a route is loaded." Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- small notch values; its width follows their number -->
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE70E;" Style="{StaticResource IconGlyph}"/></Border>
                                <StackPanel>
                                    <TextBlock Text="Small notch" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Values shown when minimized." Style="{StaticResource CardText}"/>
                                    <WrapPanel x:Name="CompactChips" Margin="0,8,0,-6">
                                        <CheckBox Style="{StaticResource Chip}" Tag="Power" Content="Power" Click="CompactChip_Click"/>
                                        <CheckBox Style="{StaticResource Chip}" Tag="HeartRate" Content="Heart rate" Click="CompactChip_Click"/>
                                        <CheckBox Style="{StaticResource Chip}" Tag="Cadence" Content="Cadence" Click="CompactChip_Click"/>
                                        <CheckBox Style="{StaticResource Chip}" Tag="Speed" Content="Speed" Click="CompactChip_Click"/>
                                        <CheckBox Style="{StaticResource Chip}" Tag="Distance" Content="Distance" Click="CompactChip_Click"/>
                                        <CheckBox Style="{StaticResource Chip}" Tag="Climb" Content="Climb" Click="CompactChip_Click"/>
                                        <CheckBox Style="{StaticResource Chip}" Tag="Time" Content="Time" Click="CompactChip_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}"/></Border>
                                <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource PillButton}" VerticalAlignment="Center" Click="ResetPosition_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Position" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Back to the default spot." Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- == Rider == -->
                <ScrollViewer x:Name="RiderPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="RIDER" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><TextBlock Text="&#xE945;" Style="{StaticResource IconGlyph}"/></Border>
                                <TextBox x:Name="FtpBox" DockPanel.Dock="Right" Style="{StaticResource InputBox}" Margin="10,0,0,0" TextChanged="Rider_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="FTP (W)" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><TextBlock Text="&#xE77B;" Style="{StaticResource IconGlyph}"/></Border>
                                <TextBox x:Name="RiderBox" DockPanel.Dock="Right" Style="{StaticResource InputBox}" Margin="10,0,0,0" TextChanged="Rider_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Rider weight (kg)" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><TextBlock Text="kg" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBox x:Name="BikeBox" DockPanel.Dock="Right" Style="{StaticResource InputBox}" Margin="10,0,0,0" TextChanged="Rider_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Bike weight (kg)" Style="{StaticResource CardTitle}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><TextBlock Text="Cd" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBox x:Name="CdaBox" DockPanel.Dock="Right" Style="{StaticResource InputBox}" Margin="10,0,0,0" TextChanged="Rider_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CdA (m²)" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="About 0.32 on the hoods, 0.25 aero." Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="RiderError" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" Margin="4,0,0,6" Visibility="Collapsed"/>

                        <TextBlock Text="TRAINER" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="DifficultyValue" DockPanel.Dock="Right" Style="{StaticResource Value}"/>
                                        <TextBlock Text="Trainer gradient" Style="{StaticResource CardTitle}"/>
                                    </DockPanel>
                                    <TextBlock Text="Share of the real gradient. Zwift default: 50 %." Style="{StaticResource CardText}"/>
                                    <Slider x:Name="DifficultySlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" Margin="0,4,0,0" ValueChanged="Rider_Changed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- == Bluetooth == -->
                <DockPanel x:Name="BluetoothPage" Visibility="Collapsed" Margin="0,0,6,0">
                    <StackPanel DockPanel.Dock="Top">
                        <!-- only when Bluetooth is really off: same detection as the overlay -->
                        <Border x:Name="BluetoothOffNotice" Style="{StaticResource SettingCard}" Visibility="Collapsed" Margin="0,8,0,0">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource NegativeBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE702;" Style="{StaticResource IconGlyph}" Foreground="White"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Bluetooth is off" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Turn it on in Windows settings" Style="{StaticResource CardText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="MY DEVICES" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <ListBox x:Name="MyDevicesList" Style="{StaticResource CardList}" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="Status" DockPanel.Dock="Right" Text="Not connected" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}"
                                                           Margin="0,1,10,0" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource SubtleBrush}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <UniformGrid x:Name="Actions" Columns="2" Margin="0,8,0,0" Visibility="Collapsed">
                                                <Button Content="Connect" Style="{StaticResource AccentButton}" Padding="0,6" Margin="0,0,4,0" Click="ConnectSaved_Click"/>
                                                <Button Content="Remove" Style="{StaticResource PillButton}" Padding="0,6" Margin="4,0,0,0" Click="ForgetSaved_Click"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter TargetName="Status" Property="Text" Value="Connected"/>
                                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource PositiveBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="MyDevicesEmpty" Style="{StaticResource CardText}" Margin="4,0,0,4" Visibility="Collapsed"
                                       Text="No devices yet. Trainers and straps you connect show up here."/>
                        </Grid>

                        <TextBlock Text="OTHER DEVICES" Style="{StaticResource SectionHeader}"/>
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Content="Find trainer" Style="{StaticResource PillButton}" Margin="0,0,4,0" Click="ScanTrainer_Click"/>
                            <Button Content="Find HR strap" Style="{StaticResource PillButton}" Margin="4,0,0,0" Click="ScanStrap_Click"/>
                        </UniformGrid>
                        <DockPanel Margin="4,0,0,8">
                            <CheckBox x:Name="AllDevicesBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"/>
                            <TextBlock Text="Show all devices (for trainers that don't advertise)" Style="{StaticResource CardText}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock x:Name="BleInfo" DockPanel.Dock="Bottom" Style="{StaticResource CardText}" Margin="4,6,0,0"/>
                    <Grid>
                        <!-- found devices: tap one, then choose trainer or heart rate strap -->
                        <ListBox x:Name="DeviceList" Style="{StaticResource CardList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource SubtleBrush}"/>
                                        <UniformGrid x:Name="Actions" Columns="2" Margin="0,8,0,0" Visibility="Collapsed">
                                            <Button Content="As trainer" Style="{StaticResource AccentButton}" Padding="0,6" Margin="0,0,4,0" Click="UseAsTrainer_Click"/>
                                            <Button Content="As HR strap" Style="{StaticResource AccentButton}" Padding="0,6" Margin="4,0,0,0" Click="UseAsStrap_Click"/>
                                        </UniformGrid>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="DeviceEmpty" Style="{StaticResource CardText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" Text="Found devices show up here.&#10;Close other apps using the trainer."/>
                    </Grid>
                </DockPanel>

                <!-- == Library == -->
                <DockPanel x:Name="LibraryPage" Visibility="Collapsed" Margin="0,0,6,0">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="ROUTES" Style="{StaticResource SectionHeader}"/>
                    </StackPanel>
                    <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                        <Button Content="Import" Style="{StaticResource AccentButton}" Margin="0,0,4,0" Click="Import_Click"/>
                        <Button Content="Load" Style="{StaticResource PillButton}" Margin="4,0" Click="LoadSelected_Click"/>
                        <Button Content="Delete" Style="{StaticResource PillButton}" Margin="4,0,0,0" Click="Delete_Click"/>
                    </UniformGrid>
                    <Grid>
                        <ListBox x:Name="LibraryList" Style="{StaticResource CardList}" MouseDoubleClick="LoadSelected_Click">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" Margin="0,1,10,0"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="LibraryEmpty" Text="No routes in your library yet." Style="{StaticResource CardText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>

                <!-- == Shortcuts: tap a field, press the new keys == -->
                <ScrollViewer x:Name="KeysPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource CardText}" Margin="4,-2,0,10"
                                   Text="They work in every app, also over a video. Tap a shortcut and press the new keys. Esc cancels, Delete removes it."/>
                        <ItemsControl x:Name="HotkeyList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SettingCard}" Padding="12,9">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource KeyButton}" Content="{Binding Keys}" Tag="{Binding RecordingTag}"
                                                    VerticalAlignment="Center" Margin="10,0,0,0" Click="HotkeyButton_Click"
                                                    PreviewKeyDown="HotkeyButton_PreviewKeyDown" PreviewKeyUp="HotkeyButton_PreviewKeyUp"
                                                    LostKeyboardFocus="HotkeyButton_LostKeyboardFocus"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitle}"/>
                                                <TextBlock x:Name="Note" Text="{Binding Note}" Style="{StaticResource CardText}" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasNote}" Value="True">
                                            <Setter TargetName="Note" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Warn}" Value="True">
                                            <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Reset to defaults" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,2,0,8" Click="ResetHotkeys_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
